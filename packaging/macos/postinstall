#!/bin/bash
# StructuraCost Post-Installation Script for macOS
# Automatically downloads and installs libsodium if not present

set -e

APP_BUNDLE="/Applications/structuracost.app"
FRAMEWORKS_DIR="${APP_BUNDLE}/Contents/Frameworks"
LIBSODIUM_VERSION="1.0.20"
LIBSODIUM_URL="https://download.libsodium.org/libsodium/releases/libsodium-${LIBSODIUM_VERSION}.tar.gz"
BUILD_DIR="/tmp/libsodium-build-$$"

echo "StructuraCost: Checking for libsodium..."

# Function to check if libsodium is installed
check_libsodium() {
    # Check bundled library in app
    if [ -f "${FRAMEWORKS_DIR}/libsodium.dylib" ] || [ -f "${FRAMEWORKS_DIR}/libsodium.23.dylib" ]; then
        echo "✓ libsodium found in app bundle"
        return 0
    fi

    # Check Homebrew (ARM)
    if [ -f "/opt/homebrew/lib/libsodium.dylib" ]; then
        echo "✓ libsodium found in Homebrew (ARM)"
        return 0
    fi

    # Check Homebrew (Intel)
    if [ -f "/usr/local/lib/libsodium.dylib" ]; then
        echo "✓ libsodium found in Homebrew (Intel)"
        return 0
    fi

    # Check system libraries
    if [ -f "/usr/lib/libsodium.dylib" ]; then
        echo "✓ libsodium found in system libraries"
        return 0
    fi

    return 1
}

# Function to install libsodium from Homebrew
install_from_homebrew() {
    echo "Attempting to install libsodium from Homebrew..."

    if ! command -v brew &> /dev/null; then
        echo "Homebrew not found"
        return 1
    fi

    echo "Using Homebrew..."
    brew install libsodium 2>&1
    return $?
}

# Function to build libsodium from source
build_from_source() {
    echo "Building libsodium from source..."

    # Check for required build tools
    if ! command -v gcc &> /dev/null && ! command -v clang &> /dev/null; then
        echo "ERROR: Xcode Command Line Tools are required to build libsodium"
        echo "Install with: xcode-select --install"
        return 1
    fi

    # Create build directory
    mkdir -p "${BUILD_DIR}"
    cd "${BUILD_DIR}"

    # Download libsodium
    echo "Downloading libsodium ${LIBSODIUM_VERSION}..."
    if command -v curl &> /dev/null; then
        curl -sL "${LIBSODIUM_URL}" -o libsodium.tar.gz
    elif command -v wget &> /dev/null; then
        wget -q "${LIBSODIUM_URL}" -O libsodium.tar.gz
    else
        echo "ERROR: curl or wget is required to download libsodium"
        return 1
    fi

    # Extract
    echo "Extracting..."
    tar xzf libsodium.tar.gz
    cd "libsodium-${LIBSODIUM_VERSION}"

    # Detect architecture
    ARCH=$(uname -m)
    echo "Detected architecture: $ARCH"

    # Configure for the current architecture
    echo "Configuring..."
    ./configure --prefix="${FRAMEWORKS_DIR%/*}" --libdir="${FRAMEWORKS_DIR}" --quiet

    echo "Building... (this may take a few minutes)"
    make -j$(sysctl -n hw.ncpu) > /dev/null 2>&1

    echo "Installing to app bundle..."
    make install > /dev/null 2>&1

    # Update install names for proper dylib linking
    if [ -f "${FRAMEWORKS_DIR}/libsodium.dylib" ]; then
        install_name_tool -id "@rpath/libsodium.dylib" "${FRAMEWORKS_DIR}/libsodium.dylib" 2>/dev/null || true
    fi

    # Cleanup
    cd /
    rm -rf "${BUILD_DIR}"

    echo "✓ libsodium built and installed successfully"
    return 0
}

# Function to create symlink from Homebrew
link_from_homebrew() {
    echo "Creating symlink from Homebrew installation..."

    local BREW_LIB=""
    if [ -f "/opt/homebrew/lib/libsodium.dylib" ]; then
        BREW_LIB="/opt/homebrew/lib/libsodium.dylib"
    elif [ -f "/usr/local/lib/libsodium.dylib" ]; then
        BREW_LIB="/usr/local/lib/libsodium.dylib"
    else
        return 1
    fi

    # Create Frameworks directory if it doesn't exist
    mkdir -p "${FRAMEWORKS_DIR}"

    # Copy instead of symlink for better portability
    cp "${BREW_LIB}" "${FRAMEWORKS_DIR}/libsodium.dylib"

    # Update install name
    install_name_tool -id "@rpath/libsodium.dylib" "${FRAMEWORKS_DIR}/libsodium.dylib" 2>/dev/null || true

    echo "✓ libsodium linked from Homebrew"
    return 0
}

# Main installation logic
if check_libsodium; then
    echo "libsodium is already available - skipping installation"
else
    echo "libsodium not found - installing..."

    # Try Homebrew first (fastest if already installed)
    if install_from_homebrew; then
        echo "✓ libsodium installed from Homebrew"
        # Link it to the app bundle
        link_from_homebrew || true
    else
        echo "Homebrew installation failed - building from source..."
        if build_from_source; then
            echo "✓ libsodium built from source successfully"
        else
            echo ""
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo "WARNING: Failed to install libsodium automatically"
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo ""
            echo "StructuraCost requires libsodium to run. Please install it manually:"
            echo ""
            echo "  Homebrew:  brew install libsodium"
            echo ""
            echo "Or build from source:"
            echo "  curl -sL https://download.libsodium.org/libsodium/releases/libsodium-${LIBSODIUM_VERSION}.tar.gz -o libsodium.tar.gz"
            echo "  tar xzf libsodium-${LIBSODIUM_VERSION}.tar.gz"
            echo "  cd libsodium-${LIBSODIUM_VERSION}"
            echo "  ./configure && make && sudo make install"
            echo ""
            exit 1
        fi
    fi
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✓ StructuraCost installation complete!"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "To launch: open -a StructuraCost"
echo ""

exit 0

